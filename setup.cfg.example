# LG TV Remote — configuration template.
#
# Copy this file to ./setup.cfg, fill it in, and run ./setup.sh. From then on
# setup.cfg is the file you edit: every run of setup.sh copies it verbatim to
# ~/.config/lgtv-remote/config.ini (mode 0600), which is what the service reads.
# Edit the copy directly and the next ./setup.sh will replace it — the previous
# contents are kept once as config.ini.bak if they differed.
#
# Neither setup.cfg nor the installed copy is tracked by git; they hold your
# MAC address and network layout.
#
# Every key can also be overridden by an environment variable, which wins over
# the file. Useful for a one-off: LGTV_HOST=other-tv ./bin/lgtvd

[tv]
# Entry from ~/.ssh/config that reaches the TV as root.        [LGTV_HOST]
host = lgtv-root

# MAC address, for the Wake-on-LAN packet that powers the TV on.  [LGTV_MAC]
# Without it the widget can turn the TV off but never on.
mac =

# Broadcast address of your network — usually your subnet with .255 at the end.
#                                                          [LGTV_BROADCAST]
broadcast = 255.255.255.255

# Seconds to wait for the TV to accept a connection.   [LGTV_CONNECT_TIMEOUT]
connect_timeout = 5

# How long the shared SSH connection is kept open after the last command.
# This is what makes the volume slider feel instant.   [LGTV_CONTROL_PERSIST]
control_persist = 300

[power]
# A cold start can genuinely take this long.               [LGTV_ON_TIMEOUT]
on_timeout = 90
off_timeout = 45

# Magic packets get dropped and power-off does not always land the first time,
# so both commands are repeated this often while waiting.  [LGTV_RETRY_EVERY]
retry_every = 5

[keys]
# Remote key presses are injected straight into the TV's input layer.
#
# The device is looked up by NAME, because the numbers move: between two probes
# on the same afternoon the list grew from 7 entries to 11 as Bluetooth audio,
# a mouse and an IoT keypad appeared. The path below is only a fallback for
# when the name cannot be found.                     [LGTV_KEY_DEVICE_NAME]
device_name = LGE M-RCU - Builtin [2]
#                                                        [LGTV_KEY_DEVICE]
device = /dev/input/event4

# "Next" and "previous" on this remote are the ∧/∨ rocker, which sends channel
# up and channel down — not the media keys. Recorded by listening to every
# input device while pressing the real remote; see docs/webos-notes.md.
#
# 402 = KEY_CHANNELUP, 403 = KEY_CHANNELDOWN            [LGTV_KEY_NEXT]
next = 402
#                                                      [LGTV_KEY_PREVIOUS]
previous = 403

[cast]
# Screen streaming from this computer to the TV: Sunshine here, Moonlight there.
# Set to false to hide the tile if you do not use it.    [LGTV_CAST_ENABLED]
enabled = true

sunshine_app_id = dev.lizardbyte.app.Sunshine
sunshine_port = 47990
moonlight_app_id = com.limelight.webos
start_timeout = 90
stop_timeout = 20

[daemon]
# How often the TV is asked about its state, while the panel is CLOSED.
#
# Zero — the default — means not at all. Nobody is looking at a closed panel,
# and every poll is a connection to the TV; at 30 seconds that would be close
# to three thousand of them a day to refresh a number no one reads. Opening the
# panel polls immediately, so nothing is lost by leaving this off.
#
# Set it only if something other than the widget reads the state — a script of
# your own on the session bus, say.                          [LGTV_POLL_IDLE]
poll_idle = 0

# While the panel is open, or while powering on/off is still in flight.
#                                                          [LGTV_POLL_ACTIVE]
poll_active = 5

# Accepted and ignored, kept so upgrading does not warn about a missing key.
# Dragging the slider produces far more events than the TV can absorb; only the
# newest value is ever sent, and that is done by coalescing the queued job
# rather than by pausing.                           [LGTV_VOLUME_THROTTLE_MS]
volume_throttle_ms = 120

# DEBUG, INFO, WARNING or ERROR.                             [LGTV_LOG_LEVEL]
log_level = INFO
