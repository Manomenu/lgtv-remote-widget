[Unit]
Description=LG TV remote service
Documentation=file://@REPO@/README.md
StartLimitIntervalSec=60
StartLimitBurst=5

# Usługa żyje dokładnie tyle, co sesja graficzna — i to jest tu istotne.
#
# Menedżer systemd użytkownika PRZEŻYWA wylogowanie, więc default.target
# zostaje osiągnięty raz, przy pierwszym zalogowaniu po starcie maszyny,
# i nigdy więcej. Usługa zaczepiona o niego nie wstaje po ponownym
# zalogowaniu — po prostu nie ma jej co pociągnąć.
#
# graphical-session.target jest zatrzymywany i uruchamiany na KAŻDE
# wylogowanie i zalogowanie, więc to on jest właściwym zaczepieniem.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@REPO@/bin/lgtvd
Restart=on-failure
RestartSec=5

# Zabezpieczenia, które NIE tworzą przestrzeni nazw montowania.
#
# Świadomie nie ma tu ProtectSystem, ProtectHome ani PrivateTmp, choć w usłudze
# systemowej byłyby oczywiste. W usłudze UŻYTKOWNIKA każde z nich uruchamia
# proces w przestrzeni nazw użytkownika, w której pliki należące do roota widać
# jako nobody:nobody. OpenSSH odmawia wtedy czytania /etc/ssh/ssh_config.d/*
# („Bad owner or permissions”) i kończy pracę z kodem 255 — czyli demon traci
# jedyny sposób rozmowy z telewizorem i melduje, że jest on wyłączony.
#
# Zmierzone na Fedorze 44 / systemd 258 / OpenSSH 10.2. Nie przywracać bez
# sprawdzenia, że ssh nadal działa z wnętrza usługi.
# RestrictNamespaces również jest tu NIEOBECNE świadomie: flatpak buduje
# piaskownicę przez bubblewrap, który potrzebuje własnych przestrzeni nazw.
# Z tym ograniczeniem uruchomienie Sunshine'a kończy się natychmiast
# komunikatem „bwrap: No permissions to create a new namespace”, a kafelek
# Screencast po prostu nie działa. Zmierzone na Fedorze 44 / flatpak 1.16.
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=graphical-session.target
